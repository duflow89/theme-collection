{
  "manifest_version": 3,
  "name": "Brushbug Cozy Night",
  "version": "1.0.0",
  "description": "An unofficial dark and cozy Chrome fan theme inspired by the brushbug from Witch Hat Atelier",
  "icons": {
    "128": "store-assets/store-icon-128.png"
  },
  "theme": {
    "images": {
      "theme_ntp_background": "images/theme_ntp_background_qhd.png"
    },
    "colors": {
      "frame": [7, 13, 25],
      "frame_inactive": [18, 27, 42],
      "toolbar": [24, 32, 43],
      "tab_text": [246, 228, 190],
      "tab_background_text": [182, 170, 146],
      "bookmark_text": [246, 228, 190],
      "ntp_background": [7, 14, 25],
      "ntp_text": [244, 224, 185],
      "ntp_link": [219, 167, 92],
      "button_background": [188, 126, 54]
    },
    "tints": {
      "buttons": [0.09, 0.35, 0.72]
    },
    "properties": {
      "ntp_background_alignment": "bottom center",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}
